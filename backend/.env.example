DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-random-64-char-secret-before-production"
JWT_EXPIRES_IN="7d"
PORT=5000
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:5000"
NODE_ENV="development"

# ── Meta Ads (Facebook / Instagram) ──────────────────────────────────────────
# Legacy env-var sync (used if no OAuth account is connected)
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# OAuth App — create at https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# ── Google Ads ────────────────────────────────────────────────────────────────
# Legacy env-var sync
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# OAuth App — create at https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: http://localhost:5000/marketing-oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ads developer token — from https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN_OAUTH=

# Sync scheduler interval in minutes (default: 30)
SYNC_INTERVAL_MINUTES=30
